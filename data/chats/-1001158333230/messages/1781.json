[
{"id":987783,"date":1794286217,"from":8781545419,"text":"我发现这些连锁店，去这些地方的人大都有些共同特征，不过不同的店特征也不同"},
{"id":987784,"date":1794286352,"from":1472644035,"text":"?"},
{"id":987785,"date":1794286367,"from":1472644035,"text":"叽里咕噜的说啥呢"},
{"id":987786,"date":1794286460,"from":8781545419,"text":"可能是因为我这里的环境比较封闭导致的","edit":1794286699},
{"id":987787,"date":1794286482,"from":8781545419,"text":"我不觉得同质化是好事"},
{"id":987788,"date":1794286487,"from":8781545419,"text":"就像我讨厌那些穿风衣的人一样"},
{"id":987789,"date":1794286558,"from":8781545419,"text":"我也讨厌品牌化符号化"},
{"id":987790,"date":1794286605,"from":6579222523,"text":"一勺冻干粉，两勺炼乳，包甜"},
{"id":987791,"date":1794286617,"from":8781545419,"text":"我不喝加牛奶和糖的","edit":1794286628},
{"id":987792,"date":1794286731,"from":8781545419,"text":"以后我要喝，肯定自己弄豆子喝"},
{"id":987793,"date":1794286738,"from":8781545419,"text":"因为自己弄有一个好处，就是能控制豆子的数量"},
{"id":987794,"date":1794286742,"from":6579222523,"text":"你喝冰美式（月之森口音"},
{"id":987795,"date":1794286759,"from":8781545419,"text":"也可以是意式浓缩"},
{"id":987796,"date":1794286827,"from":2116526758,"text":"不是，大冷天不穿厚风衣不穿羽绒服穿啥。"},
{"id":987797,"date":1794286832,"from":2116526758,"media":{"type":"sticker","size":9446,"mime":"image/webp","w":512,"h":512,"emoji":"⭐","file":"chats/-1001158333230/media/2026-11/987600/987797.webp"}},
{"id":987798,"date":1794286849,"from":2116526758,"text":"你这讨厌的根据何在？"},
{"id":987799,"date":1794286862,"from":2116526758,"text":"给我整懵了。"},
{"id":987800,"date":1794286961,"from":1472644035,"text":"没头没尾的完全阅读不能"},
{"id":987801,"date":1794286976,"from":8781545419,"text":"我说过我讨厌羽绒服了吗？"},
{"id":987802,"date":1794287016,"from":8781545419,"text":"阅读不能可以提升自己的语文水平"},
{"id":987803,"date":1794287056,"from":1472644035,"text":"你说得对，你水平很高👍"},
{"id":987804,"date":1794287072,"from":8781545419,"text":"我是说提升你的水平"},
{"id":987805,"date":1794287905,"from":8781545419,"text":"apple music的专辑整理的挺好的"}
]
