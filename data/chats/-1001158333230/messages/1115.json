{"id":630528,"date":1752590848,"from":1317086519,"text":"也有可能是因为你学校内网有https","reply":{"id":630520,"from":6096782727,"text":"不是描述文件 不是监管"}},
{"id":630529,"date":1752590848,"from":6096782727,"text":"不过学校没屏蔽小红书和telegram"},
{"id":630530,"date":1752590852,"from":8196975650,"text":"专机专用吧"},
{"id":630531,"date":1752590855,"from":6096782727,"text":"聊天内的都没屏蔽"},
{"id":630533,"date":1752590861,"from":6096782727,"text":"删掉就上不了网了","reply":{"id":630532}},
{"id":630534,"date":1752590865,"from":6096782727,"text":"连那个WiFi的时候"},
{"id":630535,"date":1752590874,"from":6096782727,"text":"因为我们学校还要用那个单点 登录账号"},
{"id":630538,"date":1752590880,"from":8196975650,"text":"提示证书错误？","reply":{"id":630534,"from":6096782727,"text":"连那个WiFi的时候"}},
{"id":630539,"date":1752590885,"from":8196975650,"text":"估计是了","reply":{"id":630536}},
{"id":630540,"date":1752590886,"from":6096782727,"text":"我们反正还要用微软账户登进去","reply":{"id":630535,"from":6096782727,"text":"因为我们学校还要用那个单点 登录账号"}},
{"id":630541,"date":1752590895,"from":6096782727,"text":"就是系统不是有一个输账号密码的地方"},
{"id":630542,"date":1752590900,"from":6096782727,"text":"你就把你微软账号的账号密码输进去"},
{"id":630543,"date":1752590910,"from":8196975650,"text":"网页认证？"},
{"id":630544,"date":1752590915,"from":6096782727,"text":"不是"},
{"id":630545,"date":1752590921,"from":6096782727,"text":"直接是设置里面就是输账号密码"},
{"id":630546,"date":1752590928,"from":8196975650,"text":"就是802.11x","edit":1752590936},
{"id":630547,"date":1752590961,"from":6096782727,"text":"我不是有安卓吗 就只能用那个访客网络"},
{"id":630548,"date":1752590968,"from":6096782727,"text":"那个就很慢"},
{"id":630549,"date":1752590973,"from":8196975650,"text":"用流量吧"},
{"id":630550,"date":1752590982,"from":6096782727,"text":"你觉得美国室内的信号很好吗"}
