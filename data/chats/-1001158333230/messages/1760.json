{"id":977304,"date":1792073942,"from":1472644035,"media":{"type":"sticker","size":17774,"mime":"image/webp","w":512,"h":382,"emoji":"🐱","file":"chats/-1001158333230/media/2026-10/977200/977304.webp"}},
{"id":977305,"date":1792073962,"from":955821087,"text":"车里大部分东西都是菊花提供的","reply":{"id":977299,"from":1472644035,"text":"这玩意不应该是江淮的？"}},
{"id":977306,"date":1792073972,"from":955821087,"text":"你在A界看到的方向盘"},
{"id":977307,"date":1792073977,"from":955821087,"text":"在B界能找到一样的"},
{"id":977308,"date":1792073983,"from":955821087,"text":"还有speaker也是"},
